{
  "id": "pan-webclient",
  "name": "网盘",
  "version": "v0.1.0",
  "description": "内置网盘服务，包含 Go 后端和已构建 React 前端。",
  "hasFrontend": true,
  "configFiles": [
    {
      "key": "env",
      "label": ".env",
      "relativePath": ".env",
      "templateRelativePath": ".env.example",
      "required": true
    }
  ],
  "runtime": {
    "pidRelativePath": ".runtime/pan-api.pid",
    "logRelativePath": ".runtime/pan-api.log",
    "startCommand": ["./start.sh"],
    "stopCommand": ["./stop.sh"]
  },
  "web": {
    "routePath": "/pan/",
    "portEnvKey": "API_PORT",
    "defaultPort": 8080
  }
}
